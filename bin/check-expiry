#!/bin/sh
# check-expiry FINGERPRINT DAYS: fails when the secret key FINGERPRINT in GNUPGHOME is missing, or it or its primary
# key expires, or has expired, within DAYS days.
set -eu

gpg --batch --with-colons --list-secret-keys | awk -F: -v key="$1" -v limit="$(($(date +%s) + $2 * 86400))" '
	$1 == "sec" { primary = $7; signing = $7 }
	$1 == "ssb" { signing = $7 }
	$1 == "fpr" && $10 == key {
		found = 1
		if ((signing != "" && signing < limit) || (primary != "" && primary < limit)) {
			print "check-expiry: " key " or its primary key expires within the window" >"/dev/stderr"
			bad = 1
		}
	}
	END { exit !found || bad }'
